{
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/motd",
      "destination": "/api/motd"
    },
    {
      "source": "/staff",
      "destination": "/api/staff"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}